{
  "name": "AI Readiness Observatory",

  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "postCreateCommand": "pip install -r requirements.txt && mkdir -p ~/.dbt && cp dbt/profiles/profiles.yml ~/.dbt/profiles.yml",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "innoverio.vscode-dbt-power-user",
        "chuckjonas.duckdb",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "duckdb.databaseExtensions": [
          {
            "path": "data/ai_readiness.duckdb",
            "name": "AI Readiness Database",
            "readOnly": true
          }
        ]
      }
    }
  }
}
